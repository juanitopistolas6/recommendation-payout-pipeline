# Postgres (used by both the db container and Django)
POSTGRES_DB=corgi
POSTGRES_USER=corgi
POSTGRES_PASSWORD=corgi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gemini
GEMINI_API_KEY=your-gemini-api-key
# 1 = respuestas fijas desde archivos JSON, sin llamar a Gemini (no gasta cuota)
GEMINI_FAKE=0

# Cola de trabajos (Redis)
REDIS_URL=redis://redis:6379/0
